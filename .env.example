# Copy this file to .env for local development. Never commit .env.
APP_ENV=local

# MySQL 8.4 application connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talenthub
DB_USERNAME=talenthub_app
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_PERSISTENT=false

# Test and local fixture only; choose your own value with at least 12 characters.
TALENTHUB_TEST_PASSWORD=

# Migration operations require explicit deployment authorization in production.
ALLOW_PRODUCTION_MIGRATIONS=false
ALLOW_PRODUCTION_ROLLBACK=false

# Session/API security. Production must use HTTPS and a deployment-specific name.
SESSION_NAME=TALENTHUBSESSID
SESSION_SECURE=false
SESSION_LIFETIME=7200

# Learner AI provider. Keep the API key in deployment secrets; never commit it.
# Start with shadow mode and visible percentage 0 until rollout approval is recorded.
TALENTHUB_AI_ENABLED=false
TALENTHUB_AI_PROVIDER=9router_gemini
TALENTHUB_AI_MODEL=
TALENTHUB_AI_API_URL=
TALENTHUB_AI_API_KEY=
TALENTHUB_AI_ALLOWED_HOSTS=
TALENTHUB_AI_TIMEOUT_SECONDS=2
TALENTHUB_AI_MAX_ATTEMPTS=2
TALENTHUB_AI_PER_STUDENT_LIMIT=2
TALENTHUB_AI_GLOBAL_LIMIT=20
TALENTHUB_AI_SHADOW=true
TALENTHUB_AI_SHADOW_GATE_APPROVED=false
TALENTHUB_AI_VISIBLE_PERCENT=0
