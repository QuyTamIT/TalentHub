# ============================================================================
# TalentHub Environment Configuration
# ============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=talenthub
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_NAME=TalentHub

# Session Configuration
SESSION_LIFETIME=3600
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Security Configuration
# LƯU Ý: Trong production, APP_DEBUG phải là false
# Khuyến nghị dùng strong random password cho admin
ADMIN_DEFAULT_PASSWORD=

# Demo/Test Accounts (Chỉ dùng cho development/testing)
# Sử dụng: node scripts/login_all_roles_keep_open.js TALENTHUB_TEST_PASSWORD=YourPassword
TALENTHUB_TEST_PASSWORD=Talenthub@123

# JWT Configuration
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000

# OAuth (Google/Facebook/LinkedIn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@talenthub.local
SMTP_FROM_NAME=TalentHub

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/talenthub/app.log
