# Copy this file to .env for local development. Never commit .env.
APP_ENV=local

# MySQL 8.4 application connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talenthub
DB_USERNAME=talenthub_app
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_PERSISTENT=false

# Test and local fixture only; choose your own value with at least 12 characters.
TALENTHUB_TEST_PASSWORD=

# Local/test admin bootstrap only; never commit the real password.
TALENTHUB_ADMIN_PASSWORD=

# Migration operations require explicit deployment authorization in production.
ALLOW_PRODUCTION_MIGRATIONS=false
ALLOW_PRODUCTION_ROLLBACK=false

# Session/API security. Production must use HTTPS and a deployment-specific name.
SESSION_NAME=TALENTHUBSESSID
SESSION_SECURE=false
SESSION_LIFETIME=7200

# Learner AI provider. Keep the API key in deployment secrets; never commit it.
# These non-secret defaults are the team-100% rollout contract consumed by
# AiAvailabilityPolicy via RolloutEvidenceFactory. Override them per environment
# only after recording the matching review reference.
TALENTHUB_AI_ENABLED=true
TALENTHUB_AI_PROVIDER=gemini
TALENTHUB_AI_MODEL=gemini-3.7-flash
TALENTHUB_AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.7-flash:generateContent
TALENTHUB_AI_API_KEY=
TALENTHUB_AI_ALLOWED_HOSTS=generativelanguage.googleapis.com
TALENTHUB_AI_TIMEOUT_SECONDS=2
TALENTHUB_AI_MAX_ATTEMPTS=2
TALENTHUB_AI_PER_STUDENT_LIMIT=2
TALENTHUB_AI_GLOBAL_LIMIT=20
TALENTHUB_AI_ROADMAP_TIMEOUT_SECONDS=30
TALENTHUB_AI_ROADMAP_PER_STUDENT_LIMIT=2
TALENTHUB_AI_ROADMAP_GLOBAL_LIMIT=20
TALENTHUB_AI_SHADOW=false
TALENTHUB_AI_SHADOW_GATE_APPROVED=true
TALENTHUB_AI_VISIBLE_PERCENT=100
TALENTHUB_AI_PILOT_APPROVAL_REFERENCE=team-develop-demo-2026-08-27
TALENTHUB_AI_PILOT_PAUSED=false
TALENTHUB_AI_ROLLOUT_STAGE=50
TALENTHUB_AI_ERROR_BUDGET_VERIFIED=true
TALENTHUB_AI_FRESHNESS_SLA_VERIFIED=true
TALENTHUB_AI_VALIDATOR_PASS_RATE_VERIFIED=true
TALENTHUB_AI_PRIVACY_REVIEW_VERIFIED=true
TALENTHUB_AI_ROLLBACK_DRILL_VERIFIED=true
TALENTHUB_AI_COMPLETED_STAGES=pilot,10,25,50
TALENTHUB_AI_UNIFIED_POLICY_VERIFIED=true
TALENTHUB_AI_LAST_KNOWN_GOOD_VERIFIED=true
TALENTHUB_AI_QUEUE_MONITORING_VERIFIED=true
