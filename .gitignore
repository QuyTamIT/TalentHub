/vendor/
composer.lock

# Node
/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# PHP
*.php.cache
.phpunit.result.cache
.phpunit.cache

# Build output
/build/
/dist/
/public/assets/

# Database
*.sql.backup
*.sql.gz

# Secrets
secrets/
keys/
*.key
*.pem
*.crt
*.p12

# Uploads (nếu có)
/uploads/
public/uploads/
